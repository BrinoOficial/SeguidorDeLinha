// ===== ROBÔ SEGUIDOR DE LINHA COM PASSO =====

// -------------------------
// Pinos dos motores
// -------------------------
#define IN1 4
#define IN2 5
#define VEL_A 3   // PWM motor esquerdo
#define IN3 6
#define IN4 7
#define VEL_B 9   // PWM motor direito

// -------------------------
// Pinos dos sensores
// -------------------------
int sensor_esquerda = 10;
int sensor_direita  = 11;

// >>> ALUNOS PODEM ALTERAR AQUI <<<
// Velocidade (0 a 255)
int velocidadeReta  = 200; 
int velocidadeCurva = 180; 

// Tempo de cada "passinho"
int tempoPasso = 150;   // tempo andando (ms)
int tempoParada = 100;  // tempo parado entre passos (ms)

// -------------------------
// Funções de movimento
// -------------------------
void parar() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

void frente(int vel) {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(VEL_A, vel);
  analogWrite(VEL_B, vel);
}

void esquerda(int vel) {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(VEL_A, vel);
  analogWrite(VEL_B, vel);
}

void direita(int vel) {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  analogWrite(VEL_A, vel);
  analogWrite(VEL_B, vel);
}

// -------------------------
// Configuração inicial
// -------------------------
void setup() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(VEL_A, OUTPUT);
  pinMode(VEL_B, OUTPUT);

  pinMode(sensor_esquerda, INPUT);
  pinMode(sensor_direita, INPUT);

  Serial.begin(9600);
}

// -------------------------
// Loop principal
// -------------------------
void loop() {
  int leituraE = digitalRead(sensor_esquerda);
  int leituraD = digitalRead(sensor_direita);

  Serial.print("Esq: ");
  Serial.print(leituraE);
  Serial.print("  Dir: ");
  Serial.println(leituraD);

  // ===== Movimento em passinhos =====
  if (leituraD && !leituraE) {
    esquerda(velocidadeCurva);
    delay(tempoPasso);
  } 
  else if (leituraE && !leituraD) {
    direita(velocidadeCurva);
    delay(tempoPasso);
  } 
  else if (leituraE && leituraD) {
    parar();
    delay(tempoPasso);
  } 
  else {
    frente(velocidadeReta);
    delay(tempoPasso);
  }

  // Para sempre depois do movimento
  parar();
  delay(tempoParada);
}
