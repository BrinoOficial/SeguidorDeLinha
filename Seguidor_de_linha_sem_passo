// Hardware

// Ponte H
// EnA -> D3
// In1 -> D4
// In2 -> D5
// In3 -> D6
// In4 -> D7
// EnB -> D9

// Sensor reflexao IR
// VCC -> VCC
// GND -> GND
// Esquerda -> D10
// Direita -> D11

// Inverter motores(0 ou 1)  
int inv_motor_d = 0;
int inv_motor_e = 0;

// Variaceis de apoio
int velocidade_reta = 200; // Mude para alterar a velocidade do robo
int velocidade_curva = 200;

//Definindo os pinos para o motor E
#define IN1 4
#define IN2 5
#define VEL_A 3

//Definindo os pinos para o motor D
#define IN3 6
#define IN4 7
#define VEL_B 9

// Define os pinos do sensor de reflexao
const int sensor_esquerda = 10;
const int sensor_direita = 11;


void setup() {
// Inicializa a comunicacao serial do arduino
Serial.begin(9600);

// Inicializa os pinos do motor
pinMode(IN1, OUTPUT);
pinMode(IN2, OUTPUT);
pinMode(IN3, OUTPUT);
pinMode(IN4, OUTPUT);
pinMode(VEL_A, OUTPUT);
pinMode(VEL_B, OUTPUT);

// Inicializa os pinos dos sensores
pinMode(sensor_esquerda, INPUT);
pinMode(sensor_direita, INPUT);
}


void parar() {
Serial.println("Parar");
digitalWrite(IN1, LOW);
digitalWrite(IN2, LOW);
digitalWrite(IN3, LOW);
digitalWrite(IN4, LOW);
}

void frente(int velocidade) {
digitalWrite(IN1, !inv_motor_e);
digitalWrite(IN2, inv_motor_e);
digitalWrite(IN3, inv_motor_d);
digitalWrite(IN4, !inv_motor_d);
analogWrite(VEL_A, velocidade);
analogWrite(VEL_B, velocidade);
}

void tras(int velocidade) {
digitalWrite(IN1, inv_motor_e);
digitalWrite(IN2, !inv_motor_e);
digitalWrite(IN3, !inv_motor_d);
digitalWrite(IN4, inv_motor_d);
analogWrite(VEL_A, velocidade);
analogWrite(VEL_B, velocidade);
}

void esquerda(int velocidade) {
digitalWrite(IN1, inv_motor_e);
digitalWrite(IN2, !inv_motor_e);
digitalWrite(IN3, inv_motor_d);
digitalWrite(IN4, !inv_motor_d);
analogWrite(VEL_A, velocidade);
analogWrite(VEL_B, velocidade);
}

void direita(int velocidade) {
digitalWrite(IN1, !inv_motor_e);
digitalWrite(IN2, inv_motor_e);
digitalWrite(IN3, !inv_motor_d);
digitalWrite(IN4, inv_motor_d);
analogWrite(VEL_A, velocidade);
analogWrite(VEL_B, velocidade);
}


void loop() {

int leitura_esquerda = digitalRead(sensor_esquerda);
int leitura_direita = digitalRead(sensor_direita);

Serial.print("Sensor Esquerda: ");
Serial.print(leitura_esquerda);
Serial.print("Sensor Direita: ");
Serial.println(leitura_direita);

if(leitura_direita && !leitura_esquerda){
esquerda(velocidade_curva);
}
else if(leitura_esquerda && !leitura_direita){
direita(velocidade_curva);
}
else if(leitura_esquerda && leitura_direita){
parar();
}
else {
frente(velocidade_reta);
}
//se precisar virar à direita
analogWrite(VEL_A, velocidade_curva);
analogWrite(VEL_B, velocidade_reta);

//se precisar virar à esquerda
analogWrite(VEL_A, velocidade_reta);
analogWrite(VEL_B, velocidade_curva);
}
