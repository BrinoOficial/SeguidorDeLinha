// ===== Controle Simples de Motor =====
// Ponte H (ex: L293D ou L298N)
// IN1 -> Motor Esquerdo
// IN2 -> Motor Esquerdo
// ENA -> PWM Motor Esquerdo
// IN3 -> Motor Direito
// IN4 -> Motor Direito
// ENB -> PWM Motor Direito

#define IN1 4   // Motor Esquerdo
#define IN2 5   // Motor Esquerdo
#define VEL_A 3 // PWM motor esquerdo

#define IN3 6   // Motor Direito
#define IN4 7   // Motor Direito
#define VEL_B 9 // PWM motor direito

// >>> ALUNOS PODEM ALTERAR AQUI <<<

// Velocidade (0 a 255)
int velocidade = 200;

// Tempo em milissegundos
int tempo = 3000;

// Direção dos motores
// Para rodar, sempre um HIGH e outro LOW
// HIGH/LOW = sentido do motor
// IN1 e IN2 -> motor esquerdo
// IN3 e IN4 -> motor direito

void setup() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(VEL_A, OUTPUT);
  pinMode(VEL_B, OUTPUT);
}

void loop() {
  // --------- MOTOR ESQUERDO ---------
  digitalWrite(IN1, HIGH); // aluno muda HIGH/LOW
  digitalWrite(IN2, LOW);  // aluno muda HIGH/LOW

  // --------- MOTOR DIREITO ---------
  digitalWrite(IN3, HIGH); // aluno muda HIGH/LOW
  digitalWrite(IN4, LOW);  // aluno muda HIGH/LOW

  // Velocidade
  analogWrite(VEL_A, velocidade);
  analogWrite(VEL_B, velocidade);

  // Tempo de movimento
  delay(tempo);

  // Para os motores
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);

  while(true); // trava aqui para não repetir
}
