// ===== Controle Simples de Motor =====
// Ponte H (ex: L293D ou L298N)
// IN1 -> Motor Esquerdo
// IN2 -> Motor Esquerdo
// ENA -> PWM Motor Esquerdo
// IN3 -> Motor Direito
// IN4 -> Motor Direito
// ENB -> PWM Motor Direito

#define IN1 4   // Motor Esquerdo
#define IN2 5   // Motor Esquerdo
#define VEL_A 3 // PWM motor esquerdo

#define IN3 6   // Motor Direito
#define IN4 7   // Motor Direito
#define VEL_B 9 // PWM motor direito

// >>> ALUNOS PODEM ALTERAR AQUI <<<

// Velocidade (0 a 255)
int velocidade = 200;

// Tempos em milissegundos
int tempoFrente1 = 2000; // tempo do 1º movimento para frente
int tempoVirar   = 800;  // tempo para virar ~90 graus (ajustar!)
int tempoFrente2 = 2000; // tempo do 2º movimento para frente

void setup() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(VEL_A, OUTPUT);
  pinMode(VEL_B, OUTPUT);
}

void loop() {
  // === 1. Seguir em frente ===
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(VEL_A, velocidade);
  analogWrite(VEL_B, velocidade);
  delay(tempoFrente1);

  // === Para um instante ===
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  delay(500);

  // === 2. Virar à esquerda ===
  // Motor esquerdo para trás, motor direito para frente
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(VEL_A, velocidade);
  analogWrite(VEL_B, velocidade);
  delay(tempoVirar);

  // === Para um instante ===
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  delay(500);

  // === 3. Seguir em frente de novo ===
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(VEL_A, velocidade);
  analogWrite(VEL_B, velocidade);
  delay(tempoFrente2);

  // === Para no fim ===
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);

  while(true); // trava no fim para não repetir
}
